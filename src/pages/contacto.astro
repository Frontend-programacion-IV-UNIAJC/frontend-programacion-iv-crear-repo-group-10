---
import Layout from "../layouts/Layout.astro";
---

<Layout
  titulo="Contacto — SaborU"
  descripcion="Sugiere una receta o cuentanos que te falta."
  activo="contacto"
>
  <section class="contenedor">
    <p class="rotulo">Contacto</p>
    <h1>Sugiere una receta</h1>
    <p class="entrada">Cuentanos que cocinas cuando no tienes tiempo. Leemos todos los mensajes.</p>

    <div class="pendiente">Se construye mas adelante, cuando agreguemos JavaScript.</div>
  </section>
</Layout>

<style>
  .entrada {
    max-width: var(--ancho-lectura);
    color: var(--color-texto-suave);
  }

  .pendiente {
    margin-top: var(--esp-5);
    padding: var(--esp-6) var(--esp-4);
    border: 2px dashed var(--color-borde-fuerte);
    border-radius: var(--radio-m);
    color: var(--color-texto-tenue);
    text-align: center;
  }
</style>
